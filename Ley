    <script>
        /* === Background Canvas Particle System === */
        const canvas = document.getElementById('particleCanvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        class FloatingHeart {
            constructor() {
                this.reset();
            }

            reset() {
                this.x = Math.random() * width;
                this.y = height + Math.random() * 100;
                this.size = Math.random() * 16 + 10;
                this.speedY = Math.random() * 1.5 + 0.6;
                this.speedX = Math.sin(Math.random() * Math.PI) * 0.8;
                this.opacity = Math.random() * 0.5 + 0.3;
                this.rotation = Math.random() * 360;
                this.rotSpeed = (Math.random() - 0.5) * 1.5;
                this.symbol = ['❤️', '💖', '💗', '💓', '🌸', '✨'][Math.floor(Math.random() * 6)];
            }

            update() {
                this.y -= this.speedY;
                this.x += this.speedX;
                this.rotation += this.rotSpeed;

                if (this.y < -50) {
                    this.reset();
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate((this.rotation * Math.PI) / 180);
                ctx.globalAlpha = this.opacity;
                ctx.font = `${this.size}px sans-serif`;
                ctx.fillText(this.symbol, -this.size / 2, this.size / 2);
                ctx.restore();
            }
        }

        const particles = Array.from({ length: 25 }, () => new FloatingHeart());

        function animateCanvas() {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateCanvas);
        }

        /* === Interactive Click Spawn Particles === */
        document.addEventListener('click', (e) => {
            // Avoid spawning on buttons/modals
            if (e.target.closest('button') || e.target.closest('#modalContent')) return;
            spawnClickParticle(e.clientX, e.clientY);
            playSoftTone(440 + Math.random() * 200, 0.15);
        });

        function spawnClickParticle(x, y) {
            const emojis = ['💖', '💕', '❤️', '🌸', '✨', '💗', '🥰'];
            const p = document.createElement('div');
            p.className = 'click-particle text-2xl sm:text-3xl';
            p.innerText = emojis[Math.floor(Math.random() * emojis.length)];
            p.style.left = `${x}px`;
            p.style.top = `${y}px`;

            document.body.appendChild(p);
            setTimeout(() => p.remove(), 1200);
        }

        /* === Web Audio Synth Melody Player === */
        let audioCtx = null;
        let isMusicPlaying = false;
        let melodyTimer = null;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playSoftTone(freq, duration = 0.3) {
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, ctx.currentTime);

                gain.gain.setValueAtTime(0.08, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {
                // Audio fallback
            }
        }

        function toggleMusic() {
            const statusText = document.getElementById('musicStatusText');
            const icon = document.getElementById('musicIcon');

            if (!isMusicPlaying) {
                isMusicPlaying = true;
                statusText.innerText = "กำลังเล่นเพลง 💖";
                icon.innerText = "🎶";

                // Romantic pentatonic chime loop
                const notes = [261.63, 329.63, 392.00, 523.25, 440.00, 392.00, 329.63, 293.66];
                let idx = 0;

                melodyTimer = setInterval(() => {
                    playSoftTone(notes[idx], 0.8);
                    idx = (idx + 1) % notes.length;
                }, 650);

                triggerConfetti();
            } else {
                isMusicPlaying = false;
                statusText.innerText = "เปิดเพลงรัก 🎶";
                icon.innerText = "🎵";
                if (melodyTimer) clearInterval(melodyTimer);
            }
        }

        /* === Interactive Love Reasons Feature === */
        const loveReasons = [
            "รอยยิ้มของแพรไหมคือสิ่งที่สว่างไสวที่สุดในโลก ✨",
            "แพรไหมเป็นคนที่ใส่ใจและน่ารักกับเค้าเสมอ 💕",
            "แค่ได้ยินเสียงแพรไหมก็ทำให้เหนื่อยหายเป็นปลิดทิ้ง 🌸",
            "อยู่กับแพรไหมแล้วมีความสุขสบายใจที่สุด 🥰",
            "แพรไหมน่ารักในแบบที่เป็นตัวเองที่สุดแล้ว ❤️",
            "เพราะแพรไหมคือ แพรไหม คนเดียวในโลกที่เค้ารักที่สุด! 💖"
        ];
        let currentReasonIdx = 0;

        function showRandomLoveReason() {
            const card = document.getElementById('reasonCard');
            const numText = document.getElementById('reasonNumber');
            const text = document.getElementById('reasonText');

            card.classList.remove('hidden');
            card.classList.remove('opacity-100');
            card.classList.add('opacity-0');

            setTimeout(() => {
                numText.innerText = currentReasonIdx + 1;
                text.innerText = loveReasons[currentReasonIdx];
                currentReasonIdx = (currentReasonIdx + 1) % loveReasons.length;

                card.classList.remove('opacity-0');
                card.classList.add('opacity-100');
            }, 150);

            playSoftTone(523.25, 0.2);
        }

        /* === Modal Controls === */
        function openLetterModal() {
            const modal = document.getElementById('letterModal');
            const content = document.getElementById('modalContent');

            modal.classList.remove('pointer-events-none');
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');

            content.classList.remove('scale-90');
            content.classList.add('scale-100');

            triggerConfetti();
            playChime();
        }

        function closeLetterModal() {
            const modal = document.getElementById('letterModal');
            const content = document.getElementById('modalContent');

            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-90');

            setTimeout(() => {
                modal.classList.add('pointer-events-none');
            }, 300);
        }

        function playChime() {
            const chimeNotes = [523.25, 659.25, 783.99, 1046.50];
            chimeNotes.forEach((n, i) => {
                setTimeout(() => playSoftTone(n, 0.3), i * 100);
            });
        }

        /* === Confetti Heart Burst === */
        function triggerHeartBurst(e) {
            const rect = e.currentTarget.getBoundingClientRect();
            const x = (rect.left + rect.width / 2) / window.innerWidth;
            const y = (rect.top + rect.height / 2) / window.innerHeight;

            confetti({
                particleCount: 35,
                spread: 70,
                origin: { x: x, y: y },
                colors: ['#f43f5e', '#fb7185', '#fda4af', '#fff0f3']
            });

            playChime();
        }

        function triggerConfetti() {
            confetti({
                particleCount: 60,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#e11d48', '#f43f5e', '#fb7185', '#ffe4e6']
            });
        }

        /* Start animations on page load */
        window.onload = function() {
            animateCanvas();
        };
    </script>
</body>
</html>
